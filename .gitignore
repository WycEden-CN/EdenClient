*.idea_modules.iws
*.idea_modules.project
*.idea_modules.project.xml
*.idea_modules.project.iml
*.idea_modules.project.ipr
*.idea_modules.project.iws
*.idea_modules.project.project
*.idea_modules.project.project.xml
*.idea_modules.project.project.iml
*.idea_modules.project.project.ipr
*.idea_modules.project.project.iws
*.idea_modules.project.project.project
*.idea_modules.project.project.project.xml

# VS Code files
.vscode/

# Eclipse Gradle plugin generated files
# Eclipse Core
.project
